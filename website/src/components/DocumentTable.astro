    }

    .tabulator .tabulator-row .row-summary {
        cursor: default;
    }

    .tabulator .tabulator-cell a {
        @apply text-blue-600 hover:text-blue-800;
        text-decoration: underline;
    }

    .tabulator .tabulator-cell {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .row-summary {
        @apply text-xs bg-gray-50;
    }
    .row-summary ul {
        @apply list-disc list-inside;
    }
    .row-summary ul ul {
        @apply pl-4;
    }

    .less-important-row, 
    .less-important-row .tabulator-cell,
    .less-important-row .tabulator-cell div,
    .less-important-row .tabulator-cell span:not(.font-bold) {
        @apply text-gray-400 !important;
    }

    .less-important-row .tabulator-cell a {
        @apply text-gray-400 !important;
        text-decoration: underline;
    }

    .less-important-row .tabulator-cell a:hover {
        @apply text-gray-600 !important;
    }

    /* Mierne stmavenie badgeov v nedôležitých riadkoch aby boli stále čitateľné ale menej kričali */
    .less-important-row .tabulator-cell span.rounded {
        @apply opacity-50 !important;
    }
</style>
