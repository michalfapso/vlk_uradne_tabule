---
// src/components/DocumentTable.astro
import { TabulatorFull as Tabulator } from "tabulator-tables"; // Import here for type safety if needed, but primarily loaded client-side
import { statusTypeToIcon } from "../scripts/statusTypeToIcon.js"; // Import utility function for status type to icon mapping
import { DEFAULT_REGEX_STRING, isDataImportant } from "../scripts/documentAnalysis.js";

const {
    id = "document-table", // Default ID
    data = [], // Default to empty array
} = Astro.props;

// --- Príprava dát (moved inside component) ---
const allDocuments =
    data.map((doc) => ({
        ...doc,
        has_analysis: !!doc.analyza,
        datum_display: doc.analyza?.datum_zverejnenia || doc.datum,
    })) || [];

// Generate unique ID for the toggle button
const toggleButtonId = `${id}-toggle-summaries-btn`;
const countLabelId = `${id}-count-label`;

const defaultRegex = new RegExp(DEFAULT_REGEX_STRING, "i");

const totalCount = allDocuments.length;
const initialImportantCount = allDocuments.filter(doc => isDataImportant(doc, defaultRegex).important).length;

// Extract unique regions and districts for filters
const allKraje = [...new Set(allDocuments.map(doc => doc.kraj).filter(Boolean))].sort();
const allOkresy = [...new Set(allDocuments.map(doc => doc.okres).filter(Boolean))].sort();
---

<div class="document-table-container bg-white p-4 sm:p-6 rounded-lg shadow-md border border-gray-200 min-h-[200px]">
    <div class="flex flex-wrap gap-x-6 gap-y-3 mb-4 items-center text-sm">
        <button id={toggleButtonId} class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-1 px-3 rounded-lg transition-colors text-xs sm:text-sm">
            Rozbaliť/Zabaliť všetky
        </button>
        <label for={`${id}-important-only`} class="flex items-center cursor-pointer">
            <input type="checkbox" id={`${id}-important-only`} checked class="mr-2 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
            Iba dôležité <span id={countLabelId} class="ml-1 text-gray-600">({initialImportantCount}/{totalCount})</span>
        </label>

        <div class="flex items-center gap-2">
            <label for={`${id}-kraj-filter`}>Kraj:</label>
            <select id={`${id}-kraj-filter`} class="p-1 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500">
                <option value="">Všetky</option>
                {allKraje.map(kraj => <option value={kraj}>{kraj}</option>)}
            </select>
        </div>

        <div class="flex items-center gap-2">
            <label for={`${id}-okres-filter`}>Okres:</label>
            <select id={`${id}-okres-filter`} class="p-1 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500">
                <option value="">Všetky</option>
                {allOkresy.map(okres => <option value={okres}>{okres}</option>)}
            </select>
        </div>

        <label for={`${id}-regex-filter`} class="flex items-center">
            Regex pre nedôležité: <input type="text" id={`${id}-regex-filter`} value={DEFAULT_REGEX_STRING} class="ml-2 p-1 border border-gray-300 rounded-md w-48 focus:ring-blue-500 focus:border-blue-500" />
        </label>
    </div>
    { allDocuments.length === 0 ? <p class="text-gray-500 italic">Neboli nájdené žiadne dokumenty.</p> : <div id={id} class="text-sm border-none shadow-none" /> }
</div>

<style>
    @import "tabulator-tables/dist/css/tabulator.min.css";
</style>

<script>
    import { TabulatorFull as Tabulator } from "tabulator-tables";
    if (!window.Tabulator) { window.Tabulator = Tabulator; }
    import { statusTypeToIcon } from "../scripts/statusTypeToIcon.js";
    import { isDataImportant } from "../scripts/documentAnalysis.js";
    if (!window.statusTypeToIcon) { window.statusTypeToIcon = statusTypeToIcon; }
    if (!window.isDataImportant) { window.isDataImportant = isDataImportant; }
</script>

<script
    define:vars={{
        tableId: id,
        tableData: allDocuments,
        btnId: toggleButtonId,
        importantOnlyCheckboxId: `${id}-important-only`,
        regexInputId: `${id}-regex-filter`,
        krajFilterId: `${id}-kraj-filter`,
        okresFilterId: `${id}-okres-filter`,
        countLabelId: countLabelId,
    }}
    is:inline
>
    document.addEventListener("DOMContentLoaded", () => {
        if (!window.Tabulator) return;

        const documents = tableData;
        const container = document.getElementById(tableId);
        const toggleBtn = document.getElementById(btnId);
        const importantOnlyCheckbox = document.getElementById(importantOnlyCheckboxId);
        const regexInput = document.getElementById(regexInputId);
        const krajFilter = document.getElementById(krajFilterId);
        const okresFilter = document.getElementById(okresFilterId);
        const countLabel = document.getElementById(countLabelId);
        let table = null;

        if (!container) return;

        // --- Basic Scroll Preservation ---
        const preserveScroll = (fn) => {
            const oldHeight = document.documentElement.scrollHeight;
            const oldY = window.scrollY;
            fn();
            const newHeight = document.documentElement.scrollHeight;
            if (oldHeight > newHeight) {
                const diff = oldHeight - newHeight;
                document.body.style.paddingBottom = diff + "px";
                window.scrollTo(0, oldY);
            }
        };

        window.addEventListener("scroll", () => {
            if (parseInt(document.body.style.paddingBottom || "0", 10) > 0) {
                if (window.scrollY + window.innerHeight < document.documentElement.scrollHeight - 100) {
                    document.body.style.paddingBottom = "0px";
                }
            }
        });

        const categoryColors = {
            'LES_VYRUB': 'bg-green-700 text-white',
            'VYSTAVBA_V_PRIRODE': 'bg-orange-500 text-white',
            'ZIVOCICHY_USMRCOVANIE': 'bg-red-600 text-white',
            'CHEMIA': 'bg-purple-600 text-white',
            'VJAZD_VOZIDLA': 'bg-gray-500 text-white',
            'POLNOHOSPODARSTVO': 'bg-yellow-600 text-white',
            'VEDA_A_VYSKUM': 'bg-blue-500 text-white',
            'INZINIERSKE_SIETE': 'bg-blue-300 text-gray-800',
            'INE': 'bg-gray-300 text-gray-800'
        };

        const formatDate = (s) => s ? new Date(s).toLocaleDateString("sk-SK") : "N/A";
        let currentRegex = new RegExp(regexInput.value, "i");

        const applyFilter = () => {
            if (!table) return;
            try { currentRegex = new RegExp(regexInput.value, "i"); } catch(e) {}
            
            if (countLabel) {
                const filtered = documents.filter(d => {
                    const mk = !krajFilter.value || d.kraj === krajFilter.value;
                    const mo = !okresFilter.value || d.okres === okresFilter.value;
                    return mk && mo;
                });
                const imp = filtered.filter(d => window.isDataImportant(d, currentRegex).important).length;
                countLabel.textContent = `(${imp}/${filtered.length})`;
            }

            table.setFilter((data) => {
                const mk = !krajFilter.value || data.kraj === krajFilter.value;
                const mo = !okresFilter.value || data.okres === okresFilter.value;
                if (!mk || !mo) return false;
                return importantOnlyCheckbox.checked ? window.isDataImportant(data, currentRegex).important : true;
            });
        };

        if (documents.length > 0) {
            table = new window.Tabulator(container, {
                data: documents,
                layout: "fitColumns",
                responsiveLayout: "collapse",
                pagination: "local",
                paginationSize: 100,
                initialSort: [{ column: "datum_display", dir: "desc" }],
                rowFormatter: function (row) {
                    const el = row.getElement();
                    const d = row.getData();
                    const a = d.analyza || {};
                    const imp = window.isDataImportant(d, currentRegex).important;

                    if (!importantOnlyCheckbox.checked && !imp) {
                        el.classList.add("less-important-row");
                    } else {
                        el.classList.remove("less-important-row");
                    }

                    const summary = document.createElement("div");
                    summary.className = "row-summary";
                    summary.style.display = "none";
                    summary.style.padding = "20px";
                    summary.style.backgroundColor = "#ffffff";
                    summary.style.borderTop = "2px solid #3b82f6";

                    const createAccordion = (title, content, isPre = false) => {
                        const det = document.createElement("details");
                        det.className = "group text-xs text-gray-500 mb-2";
                        det.innerHTML = `<summary class="cursor-pointer hover:text-gray-800 font-medium list-none flex items-center"><span class="mr-2 transform transition-transform group-open:rotate-90">▶</span> ${title}</summary>`;
                        const inner = document.createElement(isPre ? "pre" : "div");
                        inner.className = "mt-2 p-3 bg-gray-50 rounded border border-gray-200 overflow-x-auto";
                        if (isPre) { inner.style.whiteSpace = "pre-wrap"; inner.style.wordBreak = "break-all"; }
                        inner.textContent = typeof content === "string" ? content : JSON.stringify(content, null, 2);
                        det.appendChild(inner);
                        
                        det.addEventListener("toggle", () => {
                            preserveScroll(() => {
                                // We don't need recalcHeight if CSS forces auto height
                                applyFilter();
                            });
                        });
                        
                        return det;
                    };

                    summary.innerHTML = `
                        <div class="mb-6 pb-4 border-b border-gray-100">
                            <h3 class="text-lg font-bold text-blue-900 mb-2">Zhrnutie analýzy</h3>
                            <p class="text-gray-800 leading-relaxed mb-4">${a.zhrnutie || "Bez zhrnutia."}</p>
                            <div class="flex gap-4">
                                <a href="${d.url}" target="_blank" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer text-sm">📄 Pôvodný dokument</a>
                                ${d.hasGis ? `<a href="https://michalfapso.github.io/vlk_zonacia_tanap/?ext_url=https://michalfapso.github.io/vlk_uradne_tabule/data/${d.docId}/gis.geojson&ext_crs=EPSG:4326" target="_blank" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 cursor-pointer text-sm">🗺️ Mapa</a>` : ''}
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
                            <div class="space-y-3">
                                <h4 class="font-bold text-gray-700 uppercase text-xs border-b border-gray-200 pb-1 mb-2">Úradné detaily</h4>
                                <div class="grid grid-cols-3 gap-1 text-sm">
                                    <div class="text-gray-500">Typ:</div><div class="col-span-2">${a.typ_dokumentu || "N/A"}</div>
                                    <div class="text-gray-500">Číslo:</div><div class="col-span-2 font-mono">${a.cislo_konania_spisu || "N/A"}</div>
                                    <div class="text-gray-500">Žiadateľ:</div><div class="col-span-2 font-semibold text-blue-800">${a.ziadatel_navrhovatel || "N/A"}</div>
                                    <div class="text-gray-500">Druhy:</div><div class="col-span-2 italic text-xs">${(a.dotknute_zivocichy_rastliny || []).join(", ") || "N/A"}</div>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <h4 class="font-bold text-gray-700 uppercase text-xs border-b border-gray-200 pb-1 mb-2">Lokalizácia</h4>
                                <div class="text-sm">
                                    <div class="text-gray-500 mb-1 font-medium">Katastrálne územia:</div>
                                    <ul class="list-disc list-inside text-xs">${(a.miesto_realizacie?.katastralne_uzemia || []).map(ku => `<li><b>${ku.nazov}</b> (${ku.parcely?.map(p => `${p.typ}-KN: ${p.cisla.join(", ")}`).join("; ") || ""})</li>`).join("") || "N/A"}</ul>
                                </div>
                            </div>
                        </div>
                    `;

                    const debug = document.createElement("div");
                    debug.className = "mt-8 pt-4 border-t border-dashed border-gray-300";
                    debug.innerHTML = `<div class="text-xs text-gray-500 my-2"><span class="inline-block w-4"></span> <b>Dôležitosť: ${imp ? "Áno" : "Nie"}</b> (Dôvod: ${window.isDataImportant(d, currentRegex).reason})</div>`;
                    if (d.laws) debug.appendChild(createAccordion("Znenia zákonov", d.laws));
                    if (d.analyza) debug.appendChild(createAccordion("JSON analýza", d.analyza, true));
                    if (d.log) debug.appendChild(createAccordion("Log / Chyby", d.log, true));
                    
                    summary.appendChild(debug);
                    el.appendChild(summary);
                },
                columns: [
                    { title: "Lehota / Dátum", field: "datum_display", width: 140, formatter: (c) => {
                        const d = c.getData();
                        const l = d.analyza?.ucast_v_konani?.lehota_na_vyjadrenie;
                        const u = /do\s+[1-7]\b/.test(l);
                        return `<div class="font-medium text-gray-600">${formatDate(c.getValue())}</div>` +
                                `${l ? `<div class="text-[10px] leading-tight mt-1 ${u ? 'text-red-600 font-bold' : 'text-gray-500'}">${l}</div>` : ""}`;
                    }},
                    { title: "Kategória", field: "analyza.kategorie_vlk", width: 130, formatter: (c) => {
                        const v = c.getValue();
                        if (!Array.isArray(v)) return "-";
                        return `<div class="flex flex-wrap gap-1">${v.map(cat => `<span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase ${categoryColors[cat] || 'bg-gray-200 text-gray-700'}">${cat}</span>`).join('')}</div>`;
                    }},
                    { title: "Zásah a Rozsah", field: "analyza.typ_zasahu", width: 300, formatter: (c) => {
                        const a = c.getData().analyza;
                        if (!a) return "-";
                        return `<div class="font-medium text-gray-800">${Array.isArray(a.typ_zasahu) ? a.typ_zasahu.join(", ") : (a.typ_zasahu || "-")}</div>
                                ${a.rozsah_zasahu ? `<div class="text-[11px] text-gray-500 italic mt-0.5">${a.rozsah_zasahu}</div>` : ""}`;
                    }},
                    { title: "Lokalita", field: "analyza.miesto_realizacie.obec", width: 150, formatter: (c) => {
                        const m = c.getData().analyza?.miesto_realizacie;
                        if (!m) return "-";
                        return `<div class="font-bold text-gray-900">${m.obec || ""}</div>
                                ${m.nazov_lokality_norm ? `<div class="text-[11px] text-gray-600 leading-tight">(${m.nazov_lokality_norm})</div>` : ""}`;
                    }},
                    { title: "Ochrana", width: 120, formatter: (c) => {
                        const a = c.getData().analyza || {};
                        const g = a.gis?.zasiahnute_chranene_uzemia || a.zasiahnute_chranene_uzemia;
                        let b = [];
                        if (g) {
                            if (g['5st_konsUEV']) b.push(`<span class="px-1 py-0.5 bg-red-700 text-white rounded text-[9px] font-bold uppercase mb-1 inline-block">5. STUPEŇ!</span>`);
                            if (g['MCHU']) b.push(`<span class="px-1 py-0.5 bg-red-600 text-white rounded text-[9px] font-bold uppercase mb-1 inline-block">MCHU</span>`);
                            if (g['UEV'] || g['CHVU']) b.push(`<span class="px-1 py-0.5 bg-green-700 text-white rounded text-[9px] font-bold uppercase mb-1 inline-block">Natura 2000</span>`);
                        }
                        if (Array.isArray(a.typ_uzemia) && a.typ_uzemia.some(t => /chko|národný park/i.test(t))) b.push(`<span class="px-1 py-0.5 bg-green-600 text-white rounded text-[9px] font-bold uppercase mb-1 inline-block">CHKO/NP</span>`);
                        if (a.miesto_realizacie?.lokalita_zastavane_uzemie) b.push(`<span class="px-1 py-0.5 bg-gray-400 text-white rounded text-[9px] font-bold uppercase mb-1 inline-block">Intravilán</span>`);
                        return `<div class="flex flex-col items-start">${b.join('') || "-"}</div>`;
                    }},
                    { title: "Žiadateľ", field: "analyza.ziadatel_navrhovatel", width: 180, formatter: (c) => `<div class="font-medium text-gray-800 break-words whitespace-normal leading-tight">${c.getValue() || "-"}</div>` },
                    { title: "Zákony", field: "analyza.zakony", minWidth: 150, formatter: (c) => {
                        const z = c.getValue();
                        if (!Array.isArray(z)) return "-";
                        return `<div class="font-medium text-gray-800 break-words whitespace-normal leading-tight">${z.map(l => `<div>${l.cislo}${l.paragrafy ? ` (§ ${l.paragrafy.join(", ")})` : ""}</div>`).join('')}</div>`;
                    }},
                ],
            });

            applyFilter();

            table.on("rowClick", (e, row) => {
                if (!row) return;
                const target = e.target;
                if (target && target.closest(".row-summary")) return;
                
                const el = row.getElement();
                if (!el) return;
                const summary = el.querySelector(".row-summary");
                if (summary) {
                    preserveScroll(() => {
                        summary.style.display = summary.style.display === "none" ? "block" : "none";
                        applyFilter();
                        // try { row.recalcHeight(); } catch(e){}
                        // table.redraw(true);
                    });
                }
            });

            importantOnlyCheckbox.addEventListener("change", applyFilter);
            regexInput.addEventListener("input", applyFilter);
            krajFilter.addEventListener("change", applyFilter);
            okresFilter.addEventListener("change", applyFilter);

            if (toggleBtn) {
                toggleBtn.addEventListener("click", () => {
                    allSummariesVisible = !allSummariesVisible;
                    preserveScroll(() => {
                        table.getRows("active").forEach(r => {
                            const el = r.getElement();
                            if(!el) return;
                            const s = el.querySelector(".row-summary");
                            if (s) {
                                s.style.display = allSummariesVisible ? "block" : "none";
                                try { r.recalcHeight(); } catch(e){}
                            }
                        });
                    });
                    toggleBtn.textContent = allSummariesVisible ? "Zabaliť všetky" : "Rozbaliť všetky";
                });
            }
        }
    });
</script>

<style is:global>
    .tabulator .tabulator-row {
        white-space: wrap;
        cursor: pointer;
    }

    .tabulator .tabulator-row .row-summary {
        cursor: default;
    }

    .tabulator .tabulator-cell a {
        @apply text-blue-600 hover:text-blue-800;
        text-decoration: underline;
    }

    .tabulator .tabulator-cell {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .row-summary {
        @apply text-xs bg-gray-50;
    }
    .row-summary ul {
        @apply list-disc list-inside;
    }
    .row-summary ul ul {
        @apply pl-4;
    }

    .less-important-row, 
    .less-important-row .tabulator-cell,
    .less-important-row .tabulator-cell div,
    .less-important-row .tabulator-cell span:not(.font-bold) {
        @apply text-gray-400 !important;
    }

    .less-important-row .tabulator-cell a {
        @apply text-gray-400 !important;
        text-decoration: underline;
    }

    .less-important-row .tabulator-cell a:hover {
        @apply text-gray-600 !important;
    }

    /* Mierne stmavenie badgeov v nedôležitých riadkoch aby boli stále čitateľné ale menej kričali */
    .less-important-row .tabulator-cell span.rounded {
        @apply opacity-50 !important;
    }
</style>

