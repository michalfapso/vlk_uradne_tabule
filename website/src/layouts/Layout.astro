---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="sk" class="bg-gray-100 text-gray-900">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Úradné tabule Životné prostredie - Nové dokumenty" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="antialiased">
        <div class="mx-auto p-4">
            <slot />
        </div>
    </body>
</html>