---
// Node.js utilities
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import glob from 'glob';

// Astro
import Layout from '../../layouts/Layout.astro';

// React
import { DocumentDetailView } from '../../components/document-grid/DocumentDetailView.tsx';
import Header from '../../components/Header.tsx';

// Export getStaticPaths function to generate static routes for all documents
export async function getStaticPaths() {
    // Helper function to safely read JSON files
    function readJsonSafe(filePath: string) {
        try {
            if (fs.existsSync(filePath)) {
                return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
            }
        } catch (error) {
            console.error(`Error reading ${filePath}:`, error);
        }
        return null;
    }

    // Helper function to safely read text files
    function readTextSafe(filePath: string) {
        try {
            if (fs.existsSync(filePath)) {
                return fs.readFileSync(filePath, 'utf-8');
            }
        } catch (error) {
            console.error(`Error reading ${filePath}:`, error);
        }
        return null;
    }

    // Define __dirname inside the function
    const __filename = fileURLToPath(import.meta.url);
    const __dirname = path.dirname(__filename);
    const allDocsBaseDir = path.resolve(__dirname, '../../../../data/docs');
    const paths = [];
    const docIdToPathMap = new Map();

    try {
        // Glob all document folders: data/docs/*/*/*/*
        console.log(`[getStaticPaths] allDocsBaseDir: ${allDocsBaseDir}`);
        const allDocDirs = glob.sync(`${allDocsBaseDir}/*/*/*/*`);
        console.log(`[getStaticPaths] Found ${allDocDirs.length} document folders`);

        for (const dirPath of allDocDirs) {
            const docId = path.basename(dirPath);

            if (!docId) continue;

            // Check if the directory has either meta.json or analysis.json
            const metaPath = path.resolve(dirPath, 'meta.json');
            const analysisPath = path.resolve(dirPath, 'analysis.json');

            const hasMeta = fs.existsSync(metaPath);
            const hasAnalysis = fs.existsSync(analysisPath);

            // Skip if neither file exists
            if (!hasMeta && !hasAnalysis) {
                console.warn(`Skipping ${docId}: no meta.json or analysis.json found`);
                continue;
            }

            // Read the files
            const meta = readJsonSafe(metaPath);
            const analysis = readJsonSafe(analysisPath);
            const logPath = path.resolve(dirPath, 'log.txt');
            const log = readTextSafe(logPath);
            const statusPath = path.resolve(dirPath, 'status.json');
            const status = readJsonSafe(statusPath);

            // Add to paths array
            paths.push({
                params: { docId },
                props: { docId, dirPath, meta, analysis, log, status }
            });

            docIdToPathMap.set(docId, dirPath);
        }

        console.log(`Generated ${paths.length} static paths for documents`);
    } catch (error) {
        console.error('Error generating static paths:', error);
    }

    return paths;
}

// Define the component props
interface Props {
    docId: string;
    dirPath: string;
    meta: any;
    analysis: any;
    log: string | null;
    status: any;
}

const { docId, dirPath, meta, analysis, log, status } = Astro.props;

// Determine the page title
const pageTitle = meta?.nazov || analysis?.cislo_konania_spisu || docId;

// Check if GIS data exists
const gisPath = path.resolve(dirPath, 'gis.geojson');
const hasGis = fs.existsSync(gisPath);

// Extract datum_display (used for tagging)
const datum_display = meta?.datum || analysis?.datum_dokumentu || 'N/A';

// Construct data object for DocumentDetailView
const documentData = {
  analyza: analysis || {},
  nazov: meta?.nazov || null,
  url: meta?.url || null,
  hasGis,
  log,
  status
};
---

<Layout title={pageTitle ? `${pageTitle} - Úradné Tabule` : `Document: ${docId}`}>
  {/* Header bar with navigation - separate React island */}
  <div class="flex justify-between items-center p-4 bg-gray-50 border-b">
    <a
      href={import.meta.env.BASE_URL}
      class="inline-flex items-center px-3 py-2 text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors"
      aria-label="Return to document list"
    >
      ← Back to Documents
    </a>
    <Header client:load />
  </div>

  {/* Main content - no ConvexClientProvider, uses auth from Header's provider */}
  <div class="p-4 max-w-[1200px] mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Document Details</h1>

    {/* DocumentDetailView Component */}
    <DocumentDetailView
      client:load
      docId={docId}
      datum_display={datum_display}
      data={documentData}
    />
  </div>
</Layout>
